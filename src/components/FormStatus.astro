---
import { SITE } from '@lib/constants';

type Props = {
  successMessage?: string;
};

const {
  successMessage = 'Listo, recibimos tu mensaje. Te respondemos dentro de las próximas 24 horas hábiles.',
} = Astro.props;
---

<div data-form-status class="hidden">
  <div
    data-status="ok"
    class="hidden rounded-xl border border-success/30 bg-success/10 px-4 py-3 text-sm text-ink-primary"
    role="status"
  >
    <div class="flex items-start gap-2.5">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mt-0.5 flex-shrink-0" aria-hidden="true">
        <circle cx="9" cy="9" r="8" stroke="#10B981" stroke-width="1.5" />
        <path d="M5.5 9l2.5 2.5L12.5 6" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>{successMessage}</span>
    </div>
  </div>

  <div
    data-status="error"
    class="hidden rounded-xl border border-error/30 bg-error/10 px-4 py-3 text-sm text-ink-primary"
    role="alert"
  >
    <div class="flex items-start gap-2.5">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mt-0.5 flex-shrink-0" aria-hidden="true">
        <circle cx="9" cy="9" r="8" stroke="#EF4444" stroke-width="1.5" />
        <path d="M9 5v4.5M9 12.5h.01" stroke="#EF4444" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <span>
        No pudimos enviar tu mensaje. Probá de nuevo o escribinos directo a
        <a href={`mailto:${SITE.contactEmail}`} class="font-medium underline">{SITE.contactEmail}</a>.
      </span>
    </div>
  </div>

  <div
    data-status="invalid"
    class="hidden rounded-xl border border-warning/30 bg-warning/10 px-4 py-3 text-sm text-ink-primary"
    role="alert"
  >
    <div class="flex items-start gap-2.5">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mt-0.5 flex-shrink-0" aria-hidden="true">
        <circle cx="9" cy="9" r="8" stroke="#F59E0B" stroke-width="1.5" />
        <path d="M9 5v4.5M9 12.5h.01" stroke="#F59E0B" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <span>Faltan algunos campos obligatorios. Revisá el formulario e intentá de nuevo.</span>
    </div>
  </div>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>('[data-form-status]');
  if (wrap) {
    const status = new URLSearchParams(window.location.search).get('status');
    const panel = status
      ? wrap.querySelector<HTMLElement>(`[data-status="${CSS.escape(status)}"]`)
      : null;
    if (panel) {
      wrap.classList.remove('hidden');
      panel.classList.remove('hidden');
      wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
      // Clean the URL so a refresh doesn't re-show the banner.
      const url = new URL(window.location.href);
      url.searchParams.delete('status');
      window.history.replaceState({}, '', url.pathname + url.search + url.hash);
    }
  }
</script>
