---
import { URLS } from '@lib/constants';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const r = t.pricing.recommender;

// Tiers que matchean con t.pricing.plans (índice 0..3 = Micro, Starter, Pro, Enterprise).
const tiers = [
  { idx: 0, upTo: 500, name: t.pricing.plans[0].name, price: t.pricing.plans[0].price },
  { idx: 1, upTo: 5000, name: t.pricing.plans[1].name, price: t.pricing.plans[1].price },
  { idx: 2, upTo: 25000, name: t.pricing.plans[2].name, price: t.pricing.plans[2].price },
];
const enterpriseName = t.pricing.plans[3].name;
const sliderMax = 30000;
const sliderInitial = 2500;
---

<section class="section bg-white dark:bg-surface-secondary">
  <div class="container-page">
    <div class="max-w-3xl" data-reveal>
      <span class="pill">{r.eyebrow}</span>
      <h2 class="mt-4 section-title">{r.title}</h2>
      <p class="section-subtitle">{r.subtitle}</p>
    </div>

    <div
      class="mt-10 rounded-2xl border border-surface-border bg-surface-secondary/40 p-6 md:p-10"
      data-plan-recommender
      data-tiers={JSON.stringify(tiers)}
      data-enterprise={enterpriseName}
      data-msg-need={r.youNeed}
      data-msg-month={r.perMonth}
      data-msg-enterprise={r.enterpriseHint}
      data-msg-sandbox={r.sandboxHint}
    >
      <div class="grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:items-center">
        <div>
          <label for="plan-volume" class="text-sm font-medium text-ink-secondary">
            {r.sliderLabel}
          </label>
          <div class="mt-3 flex items-baseline gap-2">
            <span class="font-display text-4xl font-medium text-ink-primary" data-volume>
              {sliderInitial.toLocaleString()}
            </span>
            <span class="text-sm text-ink-tertiary">
              {r.queryWord} / {r.perMonth}
            </span>
          </div>
          <input
            type="range"
            id="plan-volume"
            min="0"
            max={sliderMax}
            step="100"
            value={sliderInitial}
            class="mt-6 w-full appearance-none rounded-full bg-surface-border accent-accent"
            data-slider
          />
          <div class="mt-2 flex justify-between text-xs text-ink-tertiary">
            <span>0</span>
            <span>{Math.floor(sliderMax / 2).toLocaleString()}</span>
            <span>{sliderMax.toLocaleString()}+</span>
          </div>
        </div>

        <div class="rounded-xl border border-surface-border bg-white dark:bg-primary-950 p-6">
          <p class="text-xs font-medium uppercase tracking-wider text-ink-tertiary" data-recommendation-label>
            {r.youNeed}
          </p>
          <p class="mt-2 font-display text-3xl font-medium text-ink-primary" data-recommendation-name>
            {tiers[1].name}
          </p>
          <p class="mt-1 text-sm text-ink-secondary" data-recommendation-detail>
            {tiers[1].price} {r.perMonth}
          </p>
          <p class="mt-4 text-sm text-ink-secondary" data-recommendation-hint></p>
          <div class="mt-6">
            <a
              data-recommendation-cta
              href={URLS.SIGNUP}
              class="btn-primary w-full"
            >
              {r.selectPlanCta}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type Tier = { idx: number; upTo: number; name: string; price: string };

  const root = document.querySelector<HTMLElement>('[data-plan-recommender]');
  if (root) {
    const slider = root.querySelector<HTMLInputElement>('[data-slider]');
    const volumeEl = root.querySelector<HTMLElement>('[data-volume]');
    const nameEl = root.querySelector<HTMLElement>('[data-recommendation-name]');
    const detailEl = root.querySelector<HTMLElement>('[data-recommendation-detail]');
    const hintEl = root.querySelector<HTMLElement>('[data-recommendation-hint]');
    const ctaEl = root.querySelector<HTMLAnchorElement>('[data-recommendation-cta]');

    const tiers = JSON.parse(root.dataset.tiers ?? '[]') as Tier[];
    const enterpriseName = root.dataset.enterprise ?? 'Enterprise';
    const msgMonth = root.dataset.msgMonth ?? '';
    const msgEnterprise = root.dataset.msgEnterprise ?? '';
    const msgSandbox = root.dataset.msgSandbox ?? '';

    // Las URLs reales se las pasamos vía data attributes para que sean locale-aware.
    // Las leemos del CTA inicial y del href de "demo" en el documento.
    const signupHref = ctaEl?.getAttribute('href') ?? '/registro';
    const demoLink = document.querySelector<HTMLAnchorElement>('a[href$="/demo"]');
    const demoHref = demoLink?.getAttribute('href') ?? '/demo';

    const recommend = (volume: number) => {
      if (!nameEl || !detailEl || !ctaEl || !hintEl || !volumeEl) return;
      volumeEl.textContent = volume.toLocaleString();

      if (volume === 0) {
        // Sandbox suficiente
        nameEl.textContent = 'Sandbox';
        detailEl.textContent = '$0';
        hintEl.textContent = msgSandbox;
        ctaEl.textContent = 'Sandbox →';
        ctaEl.setAttribute('href', signupHref);
        return;
      }

      const matched = tiers.find((t) => volume <= t.upTo);
      if (matched) {
        nameEl.textContent = matched.name;
        detailEl.textContent = `${matched.price} ${msgMonth}`;
        hintEl.textContent = '';
        ctaEl.textContent = ctaEl.dataset.originalText ?? ctaEl.textContent ?? '';
        ctaEl.setAttribute('href', signupHref);
      } else {
        nameEl.textContent = enterpriseName;
        detailEl.textContent = '—';
        hintEl.textContent = msgEnterprise;
        ctaEl.textContent = '→';
        ctaEl.setAttribute('href', demoHref);
      }
    };

    // Guardar el label inicial del CTA para restaurarlo.
    if (ctaEl) ctaEl.dataset.originalText = ctaEl.textContent ?? '';

    slider?.addEventListener('input', () => {
      const value = Number(slider.value);
      recommend(value);
    });
    if (slider) recommend(Number(slider.value));
  }
</script>

<style>
  /* Slider visual con accent cyan para ambos themes. */
  input[type='range'][data-slider] {
    height: 6px;
    cursor: pointer;
  }
  input[type='range'][data-slider]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    background-color: #06b6d4;
    border: 3px solid #fff;
    box-shadow: 0 0 0 1px rgba(6, 182, 212, 0.4);
    cursor: pointer;
  }
  input[type='range'][data-slider]::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    background-color: #06b6d4;
    border: 3px solid #fff;
    box-shadow: 0 0 0 1px rgba(6, 182, 212, 0.4);
    cursor: pointer;
  }
</style>
