---
import { URLS, type NavLink } from '@lib/constants';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);

const primary: NavLink[] = [
  { label: t.nav.producto, href: localizedPath('producto', locale) },
  { label: t.nav.soluciones, href: localizedPath('soluciones', locale) },
  { label: t.nav.precios, href: localizedPath('precios', locale) },
  { label: t.nav.docs, href: URLS.DOCS, external: true },
  { label: t.nav.blog, href: localizedPath('blog', locale) },
];
---

<header
  class="sticky top-0 z-40 w-full border-b border-surface-border/60 bg-surface/80 backdrop-blur-md dark:border-primary-900/60 dark:bg-primary-950/80"
>
  <nav class="container-page flex h-16 items-center justify-between gap-6" aria-label="Navigation">
    <a href={localizedPath('', locale)} class="flex items-center gap-2" aria-label={t.nav.homeAria}>
      <Logo class="h-7 w-auto" />
    </a>

    <ul class="hidden lg:flex items-center gap-1">
      {
        primary.map((item) => (
          <li>
            <a
              href={item.href}
              class="px-3 py-2 text-sm text-ink-secondary transition-colors hover:text-ink-primary dark:text-ink-tertiary dark:hover:text-white"
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden lg:flex items-center gap-2">
      <LanguageSwitcher />
      <ThemeToggle />
      <a href={localizedPath('login', locale)} class="btn-ghost">{t.nav.login}</a>
      <a href={localizedPath('registro', locale)} class="btn-primary">{t.nav.signup}</a>
    </div>

    <div class="lg:hidden flex items-center gap-1">
      <LanguageSwitcher />
      <ThemeToggle />
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-ink-primary hover:bg-surface-secondary dark:text-white dark:hover:bg-primary-900"
        aria-label={t.nav.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-mobile-toggle
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-surface-border bg-surface dark:border-primary-900 dark:bg-primary-950"
    data-mobile-menu
  >
    <ul class="container-page flex flex-col gap-1 py-4">
      {
        primary.map((item) => (
          <li>
            <a
              href={item.href}
              class="block rounded-lg px-3 py-2.5 text-base text-ink-secondary hover:bg-surface-secondary hover:text-ink-primary dark:text-ink-tertiary dark:hover:bg-primary-900 dark:hover:text-white"
              {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="mt-2 flex flex-col gap-2 border-t border-surface-border pt-4 dark:border-primary-900">
        <a href={localizedPath('login', locale)} class="btn-secondary w-full">{t.nav.login}</a>
        <a href={localizedPath('registro', locale)} class="btn-primary w-full">{t.nav.signup}</a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const menu = document.querySelector<HTMLDivElement>('[data-mobile-menu]');

  const closeMenu = () => {
    menu?.classList.add('hidden');
    toggle?.setAttribute('aria-expanded', 'false');
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
  });

  // Cerrar al clickear cualquier link dentro del menú (evita flash de menú abierto al navegar).
  menu?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Cerrar con Escape.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.classList.contains('hidden')) closeMenu();
  });
</script>
