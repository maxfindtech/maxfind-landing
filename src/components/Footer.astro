---
import { SOCIAL, SITE, URLS, COMPANY } from '@lib/constants';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';
import Logo from './Logo.astro';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const lp = (path: string) => localizedPath(path, locale);

type Link = { label: string; href: string; external?: boolean };

const sections: { title: string; links: Link[] }[] = [
  {
    title: t.footer.sections.Producto,
    links: [
      { label: t.features.items[0].title, href: lp('producto/verificacion-dni') },
      { label: t.features.items[1].title, href: lp('producto/validacion-identidad') },
      { label: t.features.items[2].title, href: lp('producto/red-reputacion') },
      { label: t.features.items[3].title, href: lp('producto/sandbox') },
      { label: t.nav.precios, href: lp('precios') },
    ],
  },
  {
    title: t.footer.sections.Soluciones,
    links: [
      { label: t.industries.items[0].title, href: lp('soluciones/clinicas') },
      { label: t.industries.items[1].title, href: lp('soluciones/edificios') },
      { label: t.industries.items[2].title, href: lp('soluciones/fintech') },
      { label: t.industries.items[3].title, href: lp('soluciones/comercio') },
    ],
  },
  {
    title: t.footer.sections.Empresa,
    links: [
      { label: locale === 'en' ? 'About MAXFIND' : 'Sobre MAXFIND', href: lp('sobre') },
      { label: t.nav.blog, href: lp('blog') },
      { label: locale === 'en' ? 'Contact' : 'Contacto', href: lp('contacto') },
      { label: locale === 'en' ? 'Request demo' : 'Pedir demo', href: lp('demo') },
    ],
  },
  {
    title: t.footer.sections.Recursos,
    links: [
      { label: locale === 'en' ? 'Documentation' : 'Documentación', href: lp('docs') },
      { label: 'Status', href: URLS.STATUS, external: true },
      { label: 'Changelog', href: lp('changelog') },
    ],
  },
  {
    title: t.footer.sections.Legal,
    links: [
      // Los documentos legales viven solo en español (versión válida ante INDECOPI).
      { label: locale === 'en' ? 'Terms' : 'Términos', href: '/legal/terminos' },
      { label: locale === 'en' ? 'Privacy' : 'Privacidad', href: '/legal/privacidad' },
      { label: locale === 'en' ? 'Cancellation' : 'Cancelación', href: '/legal/cancelacion' },
      { label: 'Libro de reclamaciones', href: '/libro-reclamaciones' },
    ],
  },
];
---

<footer
  class="border-t border-surface-border bg-white dark:bg-surface-secondary"
>
  <div class="container-page py-16">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-6 lg:grid-cols-12">
      <div class="col-span-2 md:col-span-6 lg:col-span-4">
        <a href={lp('')} aria-label={t.nav.homeAria}>
          <Logo class="h-7 w-auto" />
        </a>
        <p class="mt-4 max-w-xs text-sm text-ink-secondary">{t.footer.tagline}</p>
        <div class="mt-6 flex items-center gap-3">
          <a
            href={SOCIAL.x}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-surface-border text-ink-secondary transition-colors hover:border-ink-tertiary hover:text-ink-primary dark:border-primary-800 dark:text-ink-tertiary dark:hover:border-primary-700 dark:hover:text-white"
            aria-label="X (Twitter)"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
            </svg>
          </a>
          <a
            href={SOCIAL.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-surface-border text-ink-secondary transition-colors hover:border-ink-tertiary hover:text-ink-primary dark:border-primary-800 dark:text-ink-tertiary dark:hover:border-primary-700 dark:hover:text-white"
            aria-label="LinkedIn"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554V14.83c0-1.34-.027-3.067-1.87-3.067-1.87 0-2.156 1.46-2.156 2.967v5.722H9.314V9h3.41v1.561h.046c.476-.9 1.637-1.85 3.37-1.85 3.602 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 11.001-4.125 2.062 2.062 0 010 4.125zM6.814 20.452H3.86V9h2.954v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.728v20.543C0 23.226.792 24 1.771 24h20.451c.979 0 1.778-.774 1.778-1.729V1.728C24 .774 23.2 0 22.222 0z" />
            </svg>
          </a>
          <a
            href={SOCIAL.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex h-9 w-9 items-center justify-center rounded-full border border-surface-border text-ink-secondary transition-colors hover:border-ink-tertiary hover:text-ink-primary dark:border-primary-800 dark:text-ink-tertiary dark:hover:border-primary-700 dark:hover:text-white"
            aria-label="GitHub"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.335-1.755-1.335-1.755-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          </a>
        </div>
      </div>

      {
        sections.map((section) => (
          <div class="lg:col-span-2">
            <h2 class="text-xs font-medium uppercase tracking-wider text-ink-tertiary">
              {section.title}
            </h2>
            <ul class="mt-4 flex flex-col gap-3">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-ink-secondary transition-colors hover:text-ink-primary dark:text-ink-tertiary dark:hover:text-white"
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-14 grid gap-6 border-t border-surface-border pt-8 md:grid-cols-[1.4fr_1fr] dark:border-primary-900"
    >
      <div class="text-sm text-ink-tertiary leading-relaxed">
        <p class="font-medium text-ink-secondary">{COMPANY.legalName}</p>
        <p>RUC {COMPANY.ruc} · {COMPANY.address}</p>
        <p>
          <a href={`tel:${COMPANY.phone.replace(/\s/g, '')}`} class="hover:text-ink-primary">{COMPANY.phone}</a>
          <span class="mx-1">·</span>
          <a href={`mailto:${COMPANY.email}`} class="hover:text-ink-primary">{COMPANY.email}</a>
        </p>
      </div>
      <div class="flex flex-col items-start gap-3 md:items-end">
        <a
          href="/libro-reclamaciones"
          class="inline-flex items-center gap-2 rounded-lg border border-surface-border bg-white px-3 py-2 text-xs font-medium text-ink-primary transition-colors hover:border-ink-tertiary dark:bg-surface-tertiary dark:text-white"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 6a2 2 0 012-2h11a2 2 0 012 2v14l-3-2-3 2-3-2-3 2V6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M8 9h7M8 12h7M8 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          Libro de reclamaciones
        </a>
        <p class="text-xs text-ink-tertiary">
          © {year} {SITE.name}. {t.footer.copyright} · {t.footer.madeIn}
        </p>
      </div>
    </div>
  </div>
</footer>
