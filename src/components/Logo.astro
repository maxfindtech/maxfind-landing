---
type Props = {
  variant?: 'light' | 'dark' | 'mono' | 'auto';
  class?: string;
};

const { variant = 'auto', class: className = 'h-7 w-auto' } = Astro.props;
---

{
  variant === 'auto' ? (
    <>
      {/* En light mode: wordmark indigo. En dark mode: wordmark blanco. */}
      <img
        src="/brand/logo-wordmark-light.png"
        alt="MAXFIND"
        width="160"
        height="32"
        class={`${className} block dark:hidden`}
        decoding="async"
      />
      <img
        src="/brand/logo-wordmark-dark.png"
        alt="MAXFIND"
        width="160"
        height="32"
        class={`${className} hidden dark:block`}
        decoding="async"
      />
    </>
  ) : (
    <img
      src={`/brand/logo-wordmark-${variant}.png`}
      alt="MAXFIND"
      width="160"
      height="32"
      class={className}
      decoding="async"
    />
  )
}
