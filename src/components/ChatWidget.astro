---
import { SITE, URLS } from '@lib/constants';

// Respuestas programadas. El matching es por keywords (sin backend).
// Si nada matchea, cae al fallback de contacto por correo.
const faqs = [
  {
    label: '¿Qué es MAXFIND?',
    keywords: ['que es', 'qué es', 'maxfind', 'producto', 'sirve', 'hacen'],
    answer:
      'MAXFIND es una API de verificación de identidad por DNI en Perú. Consultás datos contra el padrón oficial de RENIEC, validás identidad física y accedés a una red de reputación entre negocios.',
  },
  {
    label: '¿El sandbox es gratis?',
    keywords: ['sandbox', 'gratis', 'prueba', 'free', 'testear', 'probar'],
    answer:
      'Sí. El sandbox profesional con DNIs mock es gratis para siempre y no requiere tarjeta. Usalo para integrar y testear sin gastar consultas reales.',
  },
  {
    label: '¿Cómo empiezo?',
    keywords: ['empezar', 'empiezo', 'comenzar', 'arrancar', 'cuenta', 'registr'],
    answer:
      'Creás tu cuenta gratis y hacés tu primera consulta en menos de 5 minutos. <a href="/registro" class="font-medium text-accent underline">Empezá gratis acá</a>.',
  },
  {
    label: '¿Cuánto cuesta?',
    keywords: ['precio', 'cuesta', 'plan', 'planes', 'cobran', 'cuanto', 'cuánto', 'tarifa'],
    answer:
      'Los planes arrancan en S/ 19/mes. Al suscribirte tenés 30 días con 500 consultas reales sin costo. <a href="/precios" class="font-medium text-accent underline">Ver todos los planes</a>.',
  },
  {
    label: '¿De dónde salen los datos?',
    keywords: ['datos', 'fuente', 'reniec', 'padron', 'padrón', 'oficial', 'sunat'],
    answer:
      'Cada consulta resuelve contra el padrón oficial de RENIEC. Datos reales y estructurados, sin scraping.',
  },
  {
    label: '¿Es legal? ¿Protegen los datos?',
    keywords: ['legal', 'ley', 'datos personales', 'privacidad', 'seguro', 'proteccion', 'protección', '29733'],
    answer:
      'Sí. Operamos bajo la Ley 29733, con banco de datos inscrito en MINJUS y auditoría completa de cada consulta. Los datos viajan cifrados.',
  },
  {
    label: '¿Necesito convenio con RENIEC?',
    keywords: ['convenio', 'reniec', 'tramite', 'trámite', 'requisito', 'juridica', 'jurídica'],
    answer:
      'No. Esa es la idea de MAXFIND: verificás identidad sin gestionar convenios, certificados ni trámites de persona jurídica.',
  },
  {
    label: '¿Tienen documentación?',
    keywords: ['documentacion', 'documentación', 'docs', 'api', 'integrar', 'endpoint'],
    answer: `Sí, todo está en <a href="${URLS.DOCS}" target="_blank" rel="noopener noreferrer" class="font-medium text-accent underline">docs.maxfind.app</a> con ejemplos en cURL, JS y Python.`,
  },
];
---

<div data-chat class="fixed bottom-5 right-5 z-50">
  <!-- Toggle -->
  <button
    type="button"
    data-chat-toggle
    class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-white shadow-lg transition-transform hover:scale-105 active:scale-95"
    aria-label="Abrir ayuda"
    aria-expanded="false"
    aria-controls="chat-panel"
  >
    <svg data-icon-open width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 01-8.5 8.5 8.5 8.5 0 01-3.8-.9L3 21l1.9-5.7A8.38 8.38 0 014 11.5 8.5 8.5 0 0112.5 3 8.38 8.38 0 0121 11.5z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <svg data-icon-close class="hidden" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  </button>

  <!-- Panel -->
  <div
    id="chat-panel"
    data-chat-panel
    class="absolute bottom-[4.5rem] right-0 hidden w-[360px] max-w-[calc(100vw-2.5rem)] flex-col overflow-hidden rounded-2xl border border-surface-border bg-white shadow-2xl"
    role="dialog"
    aria-label="Ayuda de MAXFIND"
  >
    <div class="flex items-center gap-3 bg-primary px-4 py-3.5 text-white">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/15">
        <span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
      </span>
      <div>
        <p class="text-sm font-medium">Ayuda de MAXFIND</p>
        <p class="text-xs text-white/70">Respondemos al instante</p>
      </div>
    </div>

    <div data-chat-messages class="flex max-h-[340px] flex-col gap-3 overflow-y-auto px-4 py-4">
      <div class="max-w-[85%] rounded-2xl rounded-tl-sm bg-surface-secondary px-3.5 py-2.5 text-sm text-ink-primary">
        ¡Hola! 👋 ¿En qué te ayudo? Elegí una pregunta o escribí la tuya.
      </div>
      <div data-chat-chips class="flex flex-col gap-2">
        {
          faqs.map((faq, i) => (
            <button
              type="button"
              data-chip={i}
              class="rounded-full border border-surface-border px-3 py-1.5 text-left text-sm text-ink-secondary transition-colors hover:border-accent/50 hover:bg-surface-secondary"
            >
              {faq.label}
            </button>
          ))
        }
      </div>
    </div>

    <form data-chat-form class="flex items-center gap-2 border-t border-surface-border p-3">
      <input
        type="text"
        data-chat-input
        autocomplete="off"
        placeholder="Escribí tu pregunta…"
        class="min-w-0 flex-1 rounded-full border border-surface-border bg-white px-4 py-2 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
      />
      <button
        type="submit"
        class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-primary text-white transition-colors hover:bg-primary-900"
        aria-label="Enviar"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h11m0 0L8.5 3.5M13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </form>
  </div>

  <script type="application/json" data-chat-data set:html={JSON.stringify({ faqs, contactEmail: SITE.contactEmail })} />
</div>

<script>
  type Faq = { label: string; keywords: string[]; answer: string };

  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    const dataEl = root.querySelector<HTMLScriptElement>('[data-chat-data]');
    const { faqs, contactEmail } = JSON.parse(dataEl?.textContent ?? '{}') as {
      faqs: Faq[];
      contactEmail: string;
    };

    const toggle = root.querySelector<HTMLButtonElement>('[data-chat-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-chat-panel]');
    const iconOpen = root.querySelector<HTMLElement>('[data-icon-open]');
    const iconClose = root.querySelector<HTMLElement>('[data-icon-close]');
    const messages = root.querySelector<HTMLElement>('[data-chat-messages]');
    const form = root.querySelector<HTMLFormElement>('[data-chat-form]');
    const input = root.querySelector<HTMLInputElement>('[data-chat-input]');

    const setOpen = (open: boolean) => {
      panel?.classList.toggle('hidden', !open);
      panel?.classList.toggle('flex', open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      toggle?.setAttribute('aria-expanded', String(open));
      if (open) input?.focus();
    };

    toggle?.addEventListener('click', () => {
      setOpen(panel?.classList.contains('hidden') ?? true);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel?.classList.contains('hidden')) setOpen(false);
    });

    const scrollDown = () => {
      if (messages) messages.scrollTop = messages.scrollHeight;
    };

    const addBubble = (html: string, who: 'user' | 'bot') => {
      const el = document.createElement('div');
      el.className =
        who === 'user'
          ? 'max-w-[85%] self-end rounded-2xl rounded-tr-sm bg-primary px-3.5 py-2.5 text-sm text-white'
          : 'max-w-[85%] rounded-2xl rounded-tl-sm bg-surface-secondary px-3.5 py-2.5 text-sm text-ink-primary';
      el.innerHTML = html;
      messages?.appendChild(el);
      scrollDown();
    };

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const fallback = () => {
      const mailto = `mailto:${contactEmail}`;
      addBubble(
        `No encontré una respuesta exacta para eso. Te puede ayudar una persona: ` +
          `<a href="/contacto" class="font-medium text-accent underline">escribinos por el formulario</a> ` +
          `o mandá un correo a <a href="${mailto}" class="font-medium text-accent underline">${contactEmail}</a>.`,
        'bot',
      );
    };

    const answerFor = (query: string): string | null => {
      const norm = (s: string) =>
        s
          .toLowerCase()
          .normalize('NFD')
          .replace(/[̀-ͯ]/g, '');
      const q = norm(query);
      let best: { faq: Faq; score: number } | null = null;
      for (const faq of faqs) {
        let score = 0;
        for (const kw of faq.keywords) {
          if (q.includes(norm(kw))) score += 1;
        }
        if (score > 0 && (!best || score > best.score)) best = { faq, score };
      }
      return best ? best.faq.answer : null;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((chip) => {
      chip.addEventListener('click', () => {
        const i = Number(chip.dataset.chip);
        const faq = faqs[i];
        if (!faq) return;
        addBubble(escapeHtml(faq.label), 'user');
        setTimeout(() => addBubble(faq.answer, 'bot'), 250);
      });
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input?.value.trim() ?? '';
      if (!value) return;
      addBubble(escapeHtml(value), 'user');
      if (input) input.value = '';
      const ans = answerFor(value);
      setTimeout(() => (ans ? addBubble(ans, 'bot') : fallback()), 250);
    });
  }
</script>
