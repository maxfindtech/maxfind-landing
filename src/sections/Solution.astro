---
import { URLS } from '@lib/constants';
import { useTranslations, type Locale, localizedPath } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
---

<section class="section section-ambient bg-white dark:bg-transparent overflow-hidden">
  <div class="container-page">
    <div class="max-w-3xl" data-reveal>
      <span class="pill">{t.solution.eyebrow}</span>
      <h2 class="mt-4 section-title">{t.solution.title}</h2>
      <p class="section-subtitle">{t.solution.subtitle}</p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        t.solution.steps.map((step, i) => (
          <article class="relative rounded-2xl border border-surface-border bg-surface-secondary/40 dark:bg-surface-tertiary p-6 transition-colors hover:bg-surface-secondary">
            <span class="font-mono text-sm font-medium text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-h3-mobile md:text-h3">{step.title}</h3>
            <p class="mt-2 text-sm text-ink-secondary">{step.description}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href={localizedPath('registro', locale)} class="btn-primary">{t.solution.ctaPrimary}</a>
      <a href={URLS.DOCS} target="_blank" rel="noopener noreferrer" class="btn-secondary">
        {t.solution.ctaSecondary}
      </a>
    </div>
  </div>
</section>
