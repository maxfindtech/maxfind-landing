---
import { useTranslations, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);

const icons = [
  'M4 6h16M4 12h16M4 18h10',
  'M12 7v5l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  'M12 9v2m0 4h.01M12 3l9 4v5c0 5-3.5 9-9 10-5.5-1-9-5-9-10V7l9-4z',
  'M12 8c-1.66 0-3 .9-3 2s1.34 2 3 2 3 .9 3 2-1.34 2-3 2m0-8v8m0 0v2m0-10V4',
];
---

<section class="section section-ambient overflow-hidden">
  <div class="container-page">
    <div class="max-w-3xl" data-reveal>
      <span class="pill">{t.problem.eyebrow}</span>
      <h2 class="mt-4 section-title">{t.problem.title}</h2>
      <p class="section-subtitle">{t.problem.subtitle}</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.problem.items.map((item, i) => (
          <article class="rounded-2xl border border-surface-border bg-white dark:bg-surface-secondary p-6 transition-colors hover:border-ink-tertiary">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-error/10 text-error">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d={icons[i]} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <h3 class="mt-4 text-h3-mobile md:text-h3">{item.title}</h3>
            <p class="mt-2 text-sm text-ink-secondary">{item.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
