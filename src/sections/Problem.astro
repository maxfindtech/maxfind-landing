---
const problems = [
  {
    title: 'Tedioso',
    description: 'Chequear DNIs manualmente cliente por cliente.',
    icon: 'M4 6h16M4 12h16M4 18h10',
  },
  {
    title: 'Lento',
    description: 'Esperar respuestas de servicios públicos que demoran días.',
    icon: 'M12 7v5l3 3M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  {
    title: 'Inseguro',
    description: 'Sin forma de detectar DNIs adulterados o falsos.',
    icon: 'M12 9v2m0 4h.01M12 3l9 4v5c0 5-3.5 9-9 10-5.5-1-9-5-9-10V7l9-4z',
  },
  {
    title: 'Caro',
    description: 'Convenios RENIEC requieren persona jurídica y meses de trámite.',
    icon: 'M12 8c-1.66 0-3 .9-3 2s1.34 2 3 2 3 .9 3 2-1.34 2-3 2m0-8v8m0 0v2m0-10V4',
  },
];
---

<section class="section">
  <div class="container-page">
    <div class="max-w-3xl">
      <span class="pill">El problema</span>
      <h2 class="mt-4 section-title">Hoy validar identidad en Perú es complicado</h2>
      <p class="section-subtitle">
        Sin herramientas pensadas para developers, cada verificación termina siendo un proceso
        manual, lento y propenso a errores.
      </p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        problems.map((problem) => (
          <article class="rounded-2xl border border-surface-border bg-white p-6 transition-colors hover:border-ink-tertiary">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-error/10 text-error">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d={problem.icon} stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <h3 class="mt-4 text-h3-mobile md:text-h3">{problem.title}</h3>
            <p class="mt-2 text-sm text-ink-secondary">{problem.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
