---
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
---

<section class="section bg-white dark:bg-surface-secondary">
  <div class="container-page">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start">
        <span class="pill">{t.trust.eyebrow}</span>
        <h2 class="mt-4 section-title">{t.trust.title}</h2>
        <p class="section-subtitle">{t.trust.subtitle}</p>
        <a href={localizedPath('legal/privacidad', locale)} class="btn-secondary mt-8">
          {t.trust.cta}
        </a>
      </div>

      <ul class="space-y-3">
        {
          t.trust.items.map((point) => (
            <li class="rounded-2xl border border-surface-border bg-surface-secondary/40 p-6">
              <div class="flex items-start gap-4">
                <div class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-success/15 text-success">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 7l2.5 2.5L11 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-display text-lg font-medium text-ink-primary">{point.title}</h3>
                  <p class="mt-1 text-sm text-ink-secondary">{point.description}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
