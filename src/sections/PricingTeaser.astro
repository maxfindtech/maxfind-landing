---
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);

// En el home mostramos Micro, Starter (destacado) y Pro — 3 planes pagos
// representativos. Sandbox lo dejamos para la página /precios.
const plans = t.pricing.plans.slice(1, 4).map((p, i) => ({
  ...p,
  highlight: i === 1, // Starter
}));
---

<section class="section section-ambient overflow-hidden">
  <div class="container-page">
    <div class="max-w-3xl" data-reveal>
      <span class="pill">{t.pricing.eyebrow}</span>
      <h2 class="mt-4 section-title">{t.pricing.title}</h2>
      <p class="section-subtitle">{t.pricing.subtitle}</p>
    </div>

    <div class="mt-10 grid gap-4 rounded-2xl border border-surface-border bg-white dark:bg-surface-secondary p-6 sm:grid-cols-3 sm:p-8">
      {
        [
          { title: t.pricing.model.step1Title, description: t.pricing.model.step1Description },
          { title: t.pricing.model.step2Title, description: t.pricing.model.step2Description },
          { title: t.pricing.model.step3Title, description: t.pricing.model.step3Description },
        ].map((step, i) => (
          <div class:list={['flex gap-4', i > 0 && 'sm:border-l sm:border-surface-border sm:pl-6']}>
            <span class="font-mono text-sm font-medium text-accent">0{i + 1}</span>
            <div>
              <h3 class="font-display text-base font-medium text-ink-primary">{step.title}</h3>
              <p class="mt-1 text-sm text-ink-secondary">{step.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {
        plans.map((plan) => (
          <article
            class:list={[
              'relative rounded-2xl border p-6',
              plan.highlight
                ? 'border-primary brand-surface text-white shadow-xl md:scale-[1.02]'
                : 'border-surface-border bg-white dark:bg-surface-secondary',
            ]}
          >
            {plan.highlight && (
              <span class="absolute -top-3 left-6 inline-flex items-center gap-1.5 rounded-full bg-accent px-3 py-1 text-xs font-medium text-primary">
                {t.pricing.mostPopular}
              </span>
            )}
            <h3 class:list={['font-display text-xl font-medium', plan.highlight && '!text-white']}>
              {plan.name}
            </h3>
            <p class:list={['mt-1 text-sm', plan.highlight ? 'text-white/70' : 'text-ink-secondary']}>
              {plan.description}
            </p>
            <div class="mt-6 flex items-baseline gap-1">
              <span class:list={['font-display text-4xl font-medium', plan.highlight && '!text-white']}>
                {plan.price}
              </span>
              <span class:list={['text-sm', plan.highlight ? 'text-white/70' : 'text-ink-secondary']}>
                {t.pricing.perMonth}
              </span>
            </div>
            <ul class="mt-6 space-y-2.5">
              {plan.features.slice(0, 4).map((feature) => (
                <li class:list={['flex items-start gap-2 text-sm', plan.highlight ? 'text-white/90' : 'text-ink-secondary']}>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="mt-0.5 flex-shrink-0">
                    <path
                      d="M3.5 8.5l2.5 2.5L12.5 5"
                      stroke={plan.highlight ? '#06B6D4' : '#10B981'}
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {feature}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-10 text-center">
      <a href={localizedPath('precios', locale)} class="btn-secondary">{t.pricing.viewAll}</a>
    </div>
  </div>
</section>
