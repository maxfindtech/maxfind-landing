---
import { useTranslations, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);

// NOTA: logos ilustrativos. Reemplazar por clientes reales antes del launch.
const logos = [
  'Clínica Aurora',
  'PagaFácil',
  'Residencial Pacífico',
  'FinPe',
  'ComercioSeguro',
  'VeciNet',
];

const stats = [
  { value: '< 200ms', label: t.socialProof.stats.latency },
  { value: '99.9%', label: t.socialProof.stats.uptime },
  { value: 'RENIEC', label: t.socialProof.stats.official },
  { value: 'Ley 29733', label: t.socialProof.stats.compliance },
];
---

<section class="border-y border-surface-border bg-white dark:bg-surface-secondary dark:border-surface-border">
  <div class="container-page py-12">
    <p class="text-center text-xs font-medium uppercase tracking-wider text-ink-tertiary">
      {t.socialProof.heading}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
      {
        logos.map((logo) => (
          <span class="font-display text-lg font-medium text-ink-secondary transition-colors hover:text-ink-primary">
            {logo}
          </span>
        ))
      }
    </div>

    <div class="mt-12 grid grid-cols-2 gap-y-8 border-t border-surface-border pt-12 md:grid-cols-4 dark:border-surface-border">
      {
        stats.map((stat) => (
          <div class="text-center">
            <p class="font-display text-2xl font-medium text-ink-primary md:text-3xl">{stat.value}</p>
            <p class="mt-1 text-sm text-ink-secondary">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
