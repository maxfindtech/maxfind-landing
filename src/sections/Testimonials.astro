---
// NOTA: testimonios ilustrativos. Reemplazar por reales (con consentimiento) antes del launch.
const testimonials = [
  {
    quote:
      'Integramos MAXFIND en el onboarding en una tarde. El KYC dejó de ser el cuello de botella del registro y bajamos el abandono notablemente.',
    name: 'Daniela Reyes',
    role: 'CTO en FinPe',
    initials: 'DR',
  },
  {
    quote:
      'En admisión ahora confirmamos la identidad del paciente en segundos. Detectamos varios intentos de usar cobertura ajena que antes se nos pasaban.',
    name: 'Marco Salinas',
    role: 'Jefe de sistemas en Clínica Aurora',
    initials: 'MS',
  },
  {
    quote:
      'El sandbox nos dejó probar todo sin tocar datos reales. Cuando pasamos a producción, no tuvimos que cambiar una línea de código.',
    name: 'Lucía Ferrer',
    role: 'Founder en ComercioSeguro',
    initials: 'LF',
  },
];
---

<section class="section bg-white dark:bg-surface-secondary">
  <div class="container-page">
    <div class="max-w-3xl">
      <span class="pill">Testimonios</span>
      <h2 class="mt-4 section-title">Lo que dicen quienes ya verifican con MAXFIND</h2>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-3">
      {
        testimonials.map((t) => (
          <figure class="flex flex-col rounded-2xl border border-surface-border bg-surface-secondary/40 p-6">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" class="text-accent">
              <path
                d="M11 8c-3.3 0-6 2.7-6 6v6h6v-6H8c0-1.7 1.3-3 3-3V8zm11 0c-3.3 0-6 2.7-6 6v6h6v-6h-3c0-1.7 1.3-3 3-3V8z"
                fill="currentColor"
                opacity="0.9"
              />
            </svg>
            <blockquote class="mt-4 flex-1 text-ink-secondary text-pretty">{t.quote}</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-medium text-white">
                {t.initials}
              </span>
              <span>
                <span class="block text-sm font-medium text-ink-primary">{t.name}</span>
                <span class="block text-sm text-ink-tertiary">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
