---
import { useTranslations, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);

const initials = ['DR', 'MS', 'LF'];
---

<section class="section bg-white dark:bg-surface-secondary">
  <div class="container-page">
    <div class="max-w-3xl" data-reveal>
      <span class="pill">{t.testimonials.eyebrow}</span>
      <h2 class="mt-4 section-title">{t.testimonials.title}</h2>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-3">
      {
        t.testimonials.items.map((item, i) => (
          <figure class="flex flex-col rounded-2xl border border-surface-border bg-surface-secondary/40 p-6">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true" class="text-accent">
              <path
                d="M11 8c-3.3 0-6 2.7-6 6v6h6v-6H8c0-1.7 1.3-3 3-3V8zm11 0c-3.3 0-6 2.7-6 6v6h6v-6h-3c0-1.7 1.3-3 3-3V8z"
                fill="currentColor"
                opacity="0.9"
              />
            </svg>
            <blockquote class="mt-4 flex-1 text-ink-secondary text-pretty">{item.quote}</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-primary text-sm font-medium text-white">
                {initials[i]}
              </span>
              <span>
                <span class="block text-sm font-medium text-ink-primary">{item.name}</span>
                <span class="block text-sm text-ink-tertiary">{item.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
