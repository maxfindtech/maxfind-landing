---
import '../styles/global.css';
import { SITE } from '@lib/constants';
import {
  buildTitle,
  buildOgImage,
  organizationSchema,
  websiteSchema,
  type SeoProps,
} from '@lib/seo';
import { LOCALES, DEFAULT_LOCALE, switchLocaleUrl, type Locale } from '@i18n/ui';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import ChatWidget from '@components/ChatWidget.astro';

type Props = SeoProps & {
  hideNav?: boolean;
  hideFooter?: boolean;
  jsonLd?: object | object[];
};

const {
  title,
  description = SITE.defaultDescription,
  ogImage,
  noindex = false,
  canonical,
  hideNav = false,
  hideFooter = false,
  jsonLd,
} = Astro.props;

const locale = (Astro.currentLocale ?? DEFAULT_LOCALE) as Locale;
const htmlLang = locale === 'en' ? 'en' : 'es';
const ogLocale = locale === 'en' ? 'en_US' : 'es_PE';

const pageTitle = buildTitle(title);
const pageOgImage = buildOgImage(ogImage);
const canonicalUrl = canonical ?? Astro.url.href;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;

const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const schemas = [organizationSchema(), websiteSchema(), ...pageSchemas];

// hreflang: para cada locale, qué URL le corresponde a esta página.
const altLinks = LOCALES.map((loc) => ({
  hreflang: loc,
  href: `${SITE.url}${switchLocaleUrl(Astro.url.pathname, loc)}`,
}));
const xDefault = `${SITE.url}${switchLocaleUrl(Astro.url.pathname, DEFAULT_LOCALE)}`;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1E1B4B" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('mfx-theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored ?? (prefersDark ? 'dark' : 'light');
          document.documentElement.dataset.theme = theme;
          if (theme === 'dark') document.documentElement.classList.add('dark');
        } catch (_) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Inter:wght@400;500&family=Geist+Mono:wght@400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Inter:wght@400;500&family=Geist+Mono:wght@400&display=swap"
    />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {altLinks.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow" />}

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={pageOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${description}`} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@maxfindtech" />
    <meta name="twitter:creator" content="@maxfindtech" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={pageOgImage} />
    <meta name="twitter:image:alt" content={`${SITE.name} — ${description}`} />

    {schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}

    {
      plausibleDomain && (
        <script
          is:inline
          defer
          data-domain={plausibleDomain}
          src="https://plausible.io/js/script.js"
        />
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-primary focus:px-4 focus:py-2 focus:text-white"
    >
      {locale === 'en' ? 'Skip to content' : 'Saltar al contenido'}
    </a>
    {!hideNav && <Navbar />}
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!hideFooter && <Footer />}
    {!hideNav && <ChatWidget />}

    <script>
      // Reveal-on-scroll: respeta prefers-reduced-motion automáticamente via CSS.
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-revealed'));
      }
    </script>
  </body>
</html>
