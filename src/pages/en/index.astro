---
import Layout from '@layouts/Layout.astro';
import { softwareApplicationSchema } from '@lib/seo';
import { useTranslations, type Locale } from '@i18n/ui';
import Hero from '@sections/Hero.astro';
import SocialProof from '@sections/SocialProof.astro';
import Problem from '@sections/Problem.astro';
import Solution from '@sections/Solution.astro';
import Features from '@sections/Features.astro';
import CodeExample from '@sections/CodeExample.astro';
import PricingTeaser from '@sections/PricingTeaser.astro';
import Industries from '@sections/Industries.astro';
import TrustSecurity from '@sections/TrustSecurity.astro';
import Testimonials from '@sections/Testimonials.astro';
import CTAFinal from '@sections/CTAFinal.astro';

const locale = (Astro.currentLocale ?? 'en') as Locale;
const t = useTranslations(locale);
---

<Layout
  title={t.meta.home.title}
  description={t.meta.home.description}
  jsonLd={softwareApplicationSchema()}
>
  <Hero />
  <SocialProof />
  <Problem />
  <Solution />
  <Features />
  <CodeExample />
  <PricingTeaser />
  <Industries />
  <TrustSecurity />
  <Testimonials />
  <CTAFinal />
</Layout>
