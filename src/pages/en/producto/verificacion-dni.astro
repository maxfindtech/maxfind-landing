---
import Layout from '@layouts/Layout.astro';
import PageHero from '@components/PageHero.astro';
import FeatureRows from '@components/FeatureRows.astro';
import CodeExample from '@sections/CodeExample.astro';
import CTAFinal from '@sections/CTAFinal.astro';
import { URLS } from '@lib/constants';
import { breadcrumbSchema } from '@lib/seo';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const p = t.verificacionDni;
---

<Layout
  title={p.meta.title}
  description={p.meta.description}
  jsonLd={breadcrumbSchema([
    { name: locale === 'en' ? 'Home' : 'Inicio', path: localizedPath('', locale) },
    { name: t.nav.producto, path: localizedPath('producto', locale) },
    { name: t.features.items[0].title, path: localizedPath('producto/verificacion-dni', locale) },
  ])}
>
  <PageHero
    eyebrow={p.eyebrow}
    title={p.title}
    description={p.description}
    secondaryCta={{ label: t.hero.secondaryCta, href: URLS.DOCS }}
  />
  <FeatureRows rows={p.rows} />
  <CodeExample />
  <CTAFinal />
</Layout>
