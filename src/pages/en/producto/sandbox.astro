---
import Layout from '@layouts/Layout.astro';
import PageHero from '@components/PageHero.astro';
import FeatureRows from '@components/FeatureRows.astro';
import CTAFinal from '@sections/CTAFinal.astro';
import { URLS } from '@lib/constants';
import { breadcrumbSchema } from '@lib/seo';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const p = t.sandboxPage;
---

<Layout
  title={p.meta.title}
  description={p.meta.description}
  jsonLd={breadcrumbSchema([
    { name: locale === 'en' ? 'Home' : 'Inicio', path: localizedPath('', locale) },
    { name: t.nav.producto, path: localizedPath('producto', locale) },
    { name: t.features.items[3].title, path: localizedPath('producto/sandbox', locale) },
  ])}
>
  <PageHero
    eyebrow={p.eyebrow}
    title={p.title}
    description={p.description}
    secondaryCta={{ label: t.hero.secondaryCta, href: URLS.DOCS }}
  />
  <FeatureRows rows={p.rows} />

  <section class="section">
    <div class="container-page">
      <div class="rounded-2xl border border-surface-border bg-surface-secondary/50 p-8 md:p-10">
        <h2 class="text-h3-mobile md:text-h3">{p.readyTitle}</h2>
        <p class="mt-2 max-w-2xl text-ink-secondary text-pretty">{p.readyBody}</p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a href={localizedPath('registro', locale)} class="btn-primary">{p.readyPrimary}</a>
          <a href={localizedPath('precios', locale)} class="btn-secondary">{p.readySecondary}</a>
        </div>
      </div>
    </div>
  </section>

  <CTAFinal />
</Layout>
