---
import Layout from '@layouts/Layout.astro';
import PageHero from '@components/PageHero.astro';
import CTAFinal from '@sections/CTAFinal.astro';
import { breadcrumbSchema } from '@lib/seo';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const p = t.sobre;
---

<Layout
  title={p.meta.title}
  description={p.meta.description}
  jsonLd={breadcrumbSchema([
    { name: locale === 'en' ? 'Home' : 'Inicio', path: localizedPath('', locale) },
    { name: p.eyebrow, path: localizedPath('sobre', locale) },
  ])}
>
  <PageHero
    eyebrow={p.eyebrow}
    title={p.title}
    description={p.description}
    secondaryCta={{ label: locale === 'en' ? 'Contact' : 'Contacto', href: localizedPath('contacto', locale) }}
  />

  <section class="section bg-white dark:bg-surface-secondary">
    <div class="container-page">
      <div class="grid gap-x-12 gap-y-12 md:grid-cols-3">
        {
          p.sections.map((s) => (
            <article>
              <h2 class="text-h3-mobile md:text-h3">{s.title}</h2>
              <p class="mt-3 text-ink-secondary text-pretty leading-relaxed">{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CTAFinal />
</Layout>
