---
import Layout from '@layouts/Layout.astro';
import FAQ, { type FaqItem } from '@components/FAQ.astro';
import CTAFinal from '@sections/CTAFinal.astro';
import { URLS } from '@lib/constants';
import { breadcrumbSchema, faqSchema } from '@lib/seo';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);

const plans = t.pricing.plans.map((p, i) => ({
  ...p,
  highlight: i === 1,
  ctaHref: i === 3 ? localizedPath('demo', locale) : URLS.SIGNUP,
}));

// values flag: true / false / string
type CellValue = boolean | string;
const comparison: { label: string; values: CellValue[] }[] = [
  { label: t.pricing.comparisonRows[0], values: ['500', '5,000', '25,000', t.pricing.comparisonValues.unlimited] },
  { label: t.pricing.comparisonRows[1], values: [true, true, true, true] },
  { label: t.pricing.comparisonRows[2], values: [true, true, true, true] },
  { label: t.pricing.comparisonRows[3], values: [false, true, true, true] },
  { label: t.pricing.comparisonRows[4], values: [false, true, true, true] },
  { label: t.pricing.comparisonRows[5], values: [false, true, true, true] },
  { label: t.pricing.comparisonRows[6], values: [false, false, true, true] },
  { label: t.pricing.comparisonRows[7], values: [false, false, true, true] },
  {
    label: t.pricing.comparisonRows[8],
    values: [
      t.pricing.comparisonValues.supportEmail,
      t.pricing.comparisonValues.supportPriority,
      t.pricing.comparisonValues.supportPriority,
      t.pricing.comparisonValues.support247,
    ],
  },
];

const planNames = plans.map((p) => p.name);
const faqs: FaqItem[] = t.pricing.faqs.map((f) => ({ question: f.q, answer: f.a }));

const isFlag = (v: CellValue): v is boolean => typeof v === 'boolean';
---

<Layout
  title={t.meta.precios.title}
  description={t.meta.precios.description}
  jsonLd={[
    breadcrumbSchema([
      { name: locale === 'en' ? 'Home' : 'Inicio', path: localizedPath('', locale) },
      { name: t.nav.precios, path: localizedPath('precios', locale) },
    ]),
    faqSchema(faqs),
  ]}
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-radial-fade" aria-hidden="true"></div>
    <div class="container-page relative pt-16 pb-10 md:pt-24">
      <div class="max-w-3xl">
        <span class="pill">{t.pricing.eyebrow}</span>
        <h1 class="mt-6 text-hero-mobile md:text-h2 text-balance">{t.pricing.pageHeroTitle}</h1>
        <p class="mt-6 text-lg text-ink-secondary text-pretty">{t.pricing.pageHeroDescription}</p>
      </div>
    </div>
  </section>

  <section class="pb-8">
    <div class="container-page">
      <div class="grid gap-4 lg:grid-cols-4">
        {
          plans.map((plan) => (
            <article
              class:list={[
                'relative flex flex-col rounded-2xl border p-6',
                plan.highlight
                  ? 'border-primary bg-primary text-white shadow-xl'
                  : 'border-surface-border bg-white dark:bg-surface-secondary',
              ]}
            >
              {plan.highlight && (
                <span class="absolute -top-3 left-6 inline-flex items-center rounded-full bg-accent px-3 py-1 text-xs font-medium text-primary">
                  {t.pricing.mostPopular}
                </span>
              )}
              <h2 class:list={['font-display text-xl font-medium', plan.highlight && '!text-white']}>{plan.name}</h2>
              <p class:list={['mt-1 text-sm', plan.highlight ? 'text-white/70' : 'text-ink-secondary']}>
                {plan.description}
              </p>
              <div class="mt-5 flex items-baseline gap-1">
                <span class:list={['font-display text-3xl font-medium', plan.highlight && '!text-white']}>
                  {plan.price}
                </span>
                {plan.price.match(/^S\//) && (
                  <span class:list={['text-sm', plan.highlight ? 'text-white/70' : 'text-ink-secondary']}>
                    {t.pricing.perMonth}
                  </span>
                )}
              </div>
              <ul class="mt-6 flex-1 space-y-2.5">
                {plan.features.map((feature) => (
                  <li class:list={['flex items-start gap-2 text-sm', plan.highlight ? 'text-white/90' : 'text-ink-secondary']}>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="mt-0.5 flex-shrink-0">
                      <path
                        d="M3.5 8.5l2.5 2.5L12.5 5"
                        stroke={plan.highlight ? '#06B6D4' : '#10B981'}
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>
              <a
                href={plan.ctaHref}
                class:list={[
                  'mt-6 w-full',
                  plan.highlight
                    ? 'inline-flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-medium text-primary transition-all hover:bg-white/90 active:scale-[0.98]'
                    : 'btn-secondary',
                ]}
              >
                {plan.cta}
              </a>
            </article>
          ))
        }
      </div>

      <p class="mt-6 text-center text-sm text-ink-tertiary">{t.pricing.noteAfterCards}</p>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <h2 class="section-title">{t.pricing.compareTitle}</h2>

      <div class="mt-10 overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-sm">
          <thead>
            <tr class="border-b border-surface-border">
              <th class="py-4 pr-4 text-left font-medium text-ink-secondary">{t.pricing.compareHeaderFeature}</th>
              {planNames.map((name) => <th class="px-4 py-4 text-center font-display font-medium text-ink-primary">{name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr class="border-b border-surface-border">
                  <td class="py-4 pr-4 text-left text-ink-secondary">{row.label}</td>
                  {row.values.map((value) => (
                    <td class="px-4 py-4 text-center">
                      {isFlag(value) ? (
                        value ? (
                          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" class="mx-auto" aria-label={t.pricing.included}>
                            <path
                              d="M4 9l3.5 3.5L14 5.5"
                              stroke="#10B981"
                              stroke-width="1.75"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        ) : (
                          <span class="text-ink-tertiary" aria-label={t.pricing.notIncluded}>—</span>
                        )
                      ) : (
                        <span class="font-medium text-ink-primary">{value}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <FAQ items={faqs} title={t.faq.title} />

  <CTAFinal />
</Layout>
