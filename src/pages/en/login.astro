---
import Layout from '@layouts/Layout.astro';
import Logo from '@components/Logo.astro';
import { URLS } from '@lib/constants';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const a = t.auth.login;
---

<Layout title={a.title} description={a.subtitle} noindex hideNav hideFooter>
  <div class="relative min-h-screen overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-radial-fade" aria-hidden="true"></div>

    <div class="container-page relative flex min-h-screen flex-col items-center justify-center py-12">
      <a href={localizedPath('', locale)} class="mb-8" aria-label={t.nav.homeAria}>
        <Logo class="h-8 w-auto" />
      </a>

      <div class="w-full max-w-md rounded-2xl border border-surface-border bg-white dark:bg-surface-secondary p-8 shadow-sm">
        <h1 class="font-display text-2xl font-medium text-ink-primary">{a.title}</h1>
        <p class="mt-1 text-sm text-ink-secondary">{a.subtitle}</p>

        <div data-auth-error class="mt-5 hidden rounded-xl border border-error/30 bg-error/10 px-4 py-3 text-sm text-ink-primary" role="alert"></div>

        <form data-login-form class="mt-6 space-y-4" novalidate>
          <div>
            <label for="email" class="block text-sm font-medium text-ink-primary">{a.email}</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-input px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
              placeholder={a.emailPh}
            />
          </div>
          <div>
            <div class="flex items-center justify-between">
              <label for="password" class="block text-sm font-medium text-ink-primary">{a.password}</label>
              <a href={localizedPath('recuperar', locale)} class="text-xs text-accent hover:underline">{a.forgot}</a>
            </div>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-input px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
              placeholder={a.passwordPh}
            />
          </div>
          <button type="submit" data-submit class="btn-primary w-full">
            <span data-label>{a.submit}</span>
            <span data-spinner class="hidden">
              <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" opacity="0.25" />
                <path d="M21 12a9 9 0 00-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
              </svg>
            </span>
          </button>
        </form>

        <p class="mt-6 text-center text-sm text-ink-secondary">
          {a.noAccount}
          <a href={localizedPath('registro', locale)} class="font-medium text-accent hover:underline">{a.signup}</a>
        </p>
      </div>

      <p class="mt-6 text-xs text-ink-tertiary">
        {a.legalBefore}
        <a href={localizedPath('legal/terminos', locale)} class="underline">{a.legalTerms}</a> {a.legalAnd}
        <a href={localizedPath('legal/privacidad', locale)} class="underline">{a.legalPrivacy}</a>.
      </p>
    </div>
  </div>
</Layout>

<script define:vars={{ errorBoth: t.auth.login.errorBoth }}>
  // Errores localizados pasados por define:vars al inline script.
  window.__authMessages = window.__authMessages || {};
  window.__authMessages.errorBoth = errorBoth;
</script>

<script>
  import { login, redirectAfterAuth } from '@lib/auth';

  const form = document.querySelector<HTMLFormElement>('[data-login-form]');
  const errorBox = document.querySelector<HTMLElement>('[data-auth-error]');
  const btn = document.querySelector<HTMLButtonElement>('[data-submit]');
  const label = btn?.querySelector<HTMLElement>('[data-label]');
  const spinner = btn?.querySelector<HTMLElement>('[data-spinner]');

  const showError = (msg: string) => {
    if (!errorBox) return;
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  };
  const setLoading = (loading: boolean) => {
    if (!btn) return;
    btn.disabled = loading;
    label?.classList.toggle('hidden', loading);
    spinner?.classList.toggle('hidden', !loading);
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox?.classList.add('hidden');

    const data = new FormData(form);
    const email = String(data.get('email') ?? '').trim();
    const password = String(data.get('password') ?? '');

    if (!email || !password) {
      // @ts-ignore — variable inyectada por define:vars
      showError(window.__authMessages?.errorBoth ?? 'Required fields missing.');
      return;
    }

    setLoading(true);
    const result = await login({ email, password });
    if (result.ok) {
      redirectAfterAuth();
    } else {
      setLoading(false);
      showError(result.error);
    }
  });
</script>
