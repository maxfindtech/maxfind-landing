---
import Layout from '@layouts/Layout.astro';
import Logo from '@components/Logo.astro';
import { URLS } from '@lib/constants';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const a = t.auth.register;
---

<Layout title={a.title} description={a.subtitle} noindex hideNav hideFooter>
  <div class="relative min-h-screen overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-radial-fade" aria-hidden="true"></div>

    <div class="container-page relative grid min-h-screen items-center gap-12 py-12 lg:grid-cols-2 lg:gap-16">
      <div class="hidden lg:block">
        <a href={localizedPath('', locale)} aria-label={t.nav.homeAria}>
          <Logo class="h-8 w-auto" />
        </a>
        <h1 class="mt-10 text-h2-mobile md:text-h2 text-balance">{a.sideTitle}</h1>
        <ul class="mt-8 space-y-4">
          {
            a.sideBenefits.map((b) => (
              <li class="flex items-start gap-3 text-ink-secondary">
                <span class="mt-0.5 flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full bg-success/15 text-success">
                  <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M3 7l2.5 2.5L11 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                {b}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="mx-auto w-full max-w-md">
        <a href={localizedPath('', locale)} class="mb-8 inline-block lg:hidden" aria-label={t.nav.homeAria}>
          <Logo class="h-8 w-auto" />
        </a>

        <div class="rounded-2xl border border-surface-border bg-white dark:bg-surface-secondary p-8 shadow-sm">
          <h2 class="font-display text-2xl font-medium text-ink-primary">{a.title}</h2>
          <p class="mt-1 text-sm text-ink-secondary">{a.subtitle}</p>

          <div data-auth-error class="mt-5 hidden rounded-xl border border-error/30 bg-error/10 px-4 py-3 text-sm text-ink-primary" role="alert"></div>

          <form data-register-form class="mt-6 space-y-4" novalidate>
            <div>
              <label for="name" class="block text-sm font-medium text-ink-primary">{a.name}</label>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder={a.namePh}
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-ink-primary">{a.email}</label>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder={a.emailPh}
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-ink-primary">
                {a.company} <span class="text-ink-tertiary">{t.forms.contact.fieldOptional}</span>
              </label>
              <input type="text" id="company" name="company" autocomplete="organization" placeholder={a.companyPh}
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
            </div>
            <div>
              <label for="password" class="block text-sm font-medium text-ink-primary">{a.password}</label>
              <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" placeholder={a.passwordPh}
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20" />
            </div>
            <button type="submit" data-submit class="btn-primary w-full">
              <span data-label>{a.submit}</span>
              <span data-spinner class="hidden">
                <svg class="h-4 w-4 animate-spin" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" opacity="0.25" />
                  <path d="M21 12a9 9 0 00-9-9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                </svg>
              </span>
            </button>
          </form>

          <p class="mt-4 text-xs text-ink-tertiary">
            {a.legalBefore}
            <a href={localizedPath('legal/terminos', locale)} class="underline">{a.legalTerms}</a> {a.legalAnd}
            <a href={localizedPath('legal/privacidad', locale)} class="underline">{a.legalPrivacy}</a>.
          </p>
        </div>

        <p class="mt-6 text-center text-sm text-ink-secondary">
          {a.hasAccount}
          <a href={localizedPath('login', locale)} class="font-medium text-accent hover:underline">{a.login}</a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<script define:vars={{ errorRequired: t.auth.register.errorRequired, errorPasswordShort: t.auth.register.errorPasswordShort }}>
  window.__authMessages = window.__authMessages || {};
  window.__authMessages.errorRequired = errorRequired;
  window.__authMessages.errorPasswordShort = errorPasswordShort;
</script>

<script>
  import { register, redirectAfterAuth } from '@lib/auth';

  const form = document.querySelector<HTMLFormElement>('[data-register-form]');
  const errorBox = document.querySelector<HTMLElement>('[data-auth-error]');
  const btn = document.querySelector<HTMLButtonElement>('[data-submit]');
  const label = btn?.querySelector<HTMLElement>('[data-label]');
  const spinner = btn?.querySelector<HTMLElement>('[data-spinner]');

  const showError = (msg: string) => {
    if (!errorBox) return;
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  };
  const setLoading = (loading: boolean) => {
    if (!btn) return;
    btn.disabled = loading;
    label?.classList.toggle('hidden', loading);
    spinner?.classList.toggle('hidden', !loading);
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox?.classList.add('hidden');

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const company = String(data.get('company') ?? '').trim();
    const password = String(data.get('password') ?? '');

    // @ts-ignore — variables inyectadas por define:vars
    const msgs = window.__authMessages ?? {};

    if (!name || !email || !password) {
      showError(msgs.errorRequired ?? 'Required fields missing.');
      return;
    }
    if (password.length < 8) {
      showError(msgs.errorPasswordShort ?? 'Password too short.');
      return;
    }

    setLoading(true);
    const result = await register({ name, email, password, company: company || undefined });
    if (result.ok) {
      redirectAfterAuth();
    } else {
      setLoading(false);
      showError(result.error);
    }
  });
</script>
