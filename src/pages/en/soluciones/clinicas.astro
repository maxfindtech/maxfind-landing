---
import Layout from '@layouts/Layout.astro';
import PageHero from '@components/PageHero.astro';
import FeatureRows from '@components/FeatureRows.astro';
import CTAFinal from '@sections/CTAFinal.astro';
import { breadcrumbSchema } from '@lib/seo';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const p = t.clinicas;
---

<Layout
  title={p.meta.title}
  description={p.meta.description}
  jsonLd={breadcrumbSchema([
    { name: locale === 'en' ? 'Home' : 'Inicio', path: localizedPath('', locale) },
    { name: t.nav.soluciones, path: localizedPath('soluciones', locale) },
    { name: t.industries.items[0].title, path: localizedPath('soluciones/clinicas', locale) },
  ])}
>
  <PageHero
    eyebrow={p.eyebrow}
    title={p.title}
    description={p.description}
    secondaryCta={{ label: locale === 'en' ? 'Request demo' : 'Pedir demo', href: localizedPath('demo', locale) }}
  />
  <FeatureRows rows={p.rows} />
  <CTAFinal />
</Layout>
