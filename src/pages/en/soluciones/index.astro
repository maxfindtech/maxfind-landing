---
import Layout from '@layouts/Layout.astro';
import Industries from '@sections/Industries.astro';
import { breadcrumbSchema } from '@lib/seo';
import { useTranslations, localizedPath, type Locale } from '@i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const p = t.solucionesIndex;
---

<Layout
  title={p.meta.title}
  description={p.meta.description}
  jsonLd={breadcrumbSchema([
    { name: locale === 'en' ? 'Home' : 'Inicio', path: localizedPath('', locale) },
    { name: t.nav.soluciones, path: localizedPath('soluciones', locale) },
  ])}
>
  <div class="container-page pt-16 md:pt-24">
    <div class="max-w-3xl">
      <span class="pill">{p.eyebrow}</span>
      <h1 class="mt-6 text-hero-mobile md:text-h2 text-balance">{p.title}</h1>
      <p class="mt-6 text-lg text-ink-secondary text-pretty">{p.description}</p>
    </div>
  </div>
  <Industries />
</Layout>
