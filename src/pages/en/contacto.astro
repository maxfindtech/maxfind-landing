---
import Layout from '@layouts/Layout.astro';
import { SITE, URLS } from '@lib/constants';
import { useTranslations, type Locale } from '@i18n/ui';
import FormStatus from '@components/FormStatus.astro';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const t = useTranslations(locale);
const c = t.forms.contact;
---

<Layout title={c.title} description={c.description}>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
    <div class="container-page relative py-20 md:py-28">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr]">
        <div>
          <span class="pill">{c.eyebrow}</span>
          <h1 class="mt-6 text-hero-mobile md:text-h2 text-balance">{c.title}</h1>
          <p class="mt-6 text-lg text-ink-secondary text-pretty">{c.description}</p>
          <div class="mt-8 space-y-4 text-sm">
            <div>
              <p class="font-medium text-ink-primary">{c.emailLabel}</p>
              <a href={`mailto:${SITE.contactEmail}`} class="text-accent hover:underline">
                {SITE.contactEmail}
              </a>
            </div>
            <div>
              <p class="font-medium text-ink-primary">{c.devNoticeTitle}</p>
              <p class="text-ink-secondary">
                {c.devNoticeBody}
                <a href={URLS.DOCS} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">
                  {c.devNoticeLink}
                </a>
                {c.devNoticeAfter}
              </p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-surface-border bg-white dark:bg-surface-secondary p-8">
          <FormStatus successMessage={t.forms.status.successDefault} />
          <form action="/api/contact" method="POST" class="mt-4 space-y-4">
            <div>
              <label for="name" class="block text-sm font-medium text-ink-primary">{c.fieldName}</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder={c.fieldNamePh}
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-ink-primary">{c.fieldEmail}</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder={c.fieldEmailPh}
              />
            </div>
            <div>
              <label for="company" class="block text-sm font-medium text-ink-primary">
                {c.fieldCompany} <span class="text-ink-tertiary">{c.fieldOptional}</span>
              </label>
              <input
                type="text"
                id="company"
                name="company"
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder={c.fieldCompanyPh}
              />
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-ink-primary">{c.fieldMessage}</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                placeholder={c.fieldMessagePh}
              ></textarea>
            </div>
            <button type="submit" class="btn-primary w-full">{c.submit}</button>
            <p class="text-xs text-ink-tertiary">
              {c.legal} <a href="/legal/privacidad" class="underline">{c.legalLink}</a>.
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
