---
import Layout from '@layouts/Layout.astro';
import Industries from '@sections/Industries.astro';
---

<Layout
  title="Soluciones por industria"
  description="MAXFIND adaptado a tu industria: clínicas, edificios, fintechs y comercio formal."
>
  <div class="container-page pt-16 md:pt-24">
    <div class="max-w-3xl">
      <span class="pill">Soluciones</span>
      <h1 class="mt-6 text-hero-mobile md:text-h2 text-balance">
        Verificación de identidad para tu industria
      </h1>
      <p class="mt-6 text-lg text-ink-secondary text-pretty">
        Cada industria tiene casos de uso únicos. Acá te mostramos cómo MAXFIND se adapta al tuyo.
      </p>
    </div>
  </div>
  <Industries />
</Layout>
