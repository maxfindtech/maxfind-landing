---
import Layout from '@layouts/Layout.astro';
import FormStatus from '@components/FormStatus.astro';
---

<Layout
  title="Pedir demo"
  description="Demo personalizada para equipos enterprise. Conocé MAXFIND en 30 minutos."
>
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
    <div class="container-page relative py-20 md:py-28">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr]">
        <div>
          <span class="pill">Enterprise</span>
          <h1 class="mt-6 text-hero-mobile md:text-h2 text-balance">Pedí una demo personalizada</h1>
          <p class="mt-6 text-lg text-ink-secondary text-pretty">
            Para equipos con volumen alto o necesidades específicas. Te mostramos cómo MAXFIND
            se integra a tu stack en 30 minutos.
          </p>
          <ul class="mt-8 space-y-3 text-sm text-ink-secondary">
            <li class="flex items-start gap-2">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 flex-shrink-0" aria-hidden="true">
                <path d="M3.5 8.5l2.5 2.5L12.5 5" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Recorrido por features y casos de uso de tu industria
            </li>
            <li class="flex items-start gap-2">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 flex-shrink-0" aria-hidden="true">
                <path d="M3.5 8.5l2.5 2.5L12.5 5" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Pricing custom para volumen alto
            </li>
            <li class="flex items-start gap-2">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="mt-0.5 flex-shrink-0" aria-hidden="true">
                <path d="M3.5 8.5l2.5 2.5L12.5 5" stroke="#10B981" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              Sandbox extendido y soporte de integración
            </li>
          </ul>
        </div>

        <div class="rounded-2xl border border-surface-border bg-white dark:bg-surface-secondary p-8">
          <FormStatus successMessage="Recibimos tu solicitud de demo. Te contactamos para coordinar en las próximas 24 horas hábiles." />
          <form action="/api/demo" method="POST" class="mt-4 space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="d-name" class="block text-sm font-medium text-ink-primary">Nombre</label>
                <input
                  type="text"
                  id="d-name"
                  name="name"
                  required
                  class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                />
              </div>
              <div>
                <label for="d-role" class="block text-sm font-medium text-ink-primary">Cargo</label>
                <input
                  type="text"
                  id="d-role"
                  name="role"
                  class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
                />
              </div>
            </div>
            <div>
              <label for="d-email" class="block text-sm font-medium text-ink-primary">Email corporativo</label>
              <input
                type="email"
                id="d-email"
                name="email"
                required
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
              />
            </div>
            <div>
              <label for="d-company" class="block text-sm font-medium text-ink-primary">Empresa</label>
              <input
                type="text"
                id="d-company"
                name="company"
                required
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
              />
            </div>
            <div>
              <label for="d-volume" class="block text-sm font-medium text-ink-primary">
                Volumen estimado de consultas
              </label>
              <select
                id="d-volume"
                name="volume"
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
              >
                <option>Menos de 5,000/mes</option>
                <option>5,000 — 25,000/mes</option>
                <option>25,000 — 100,000/mes</option>
                <option>Más de 100,000/mes</option>
              </select>
            </div>
            <div>
              <label for="d-message" class="block text-sm font-medium text-ink-primary">
                Caso de uso <span class="text-ink-tertiary">(opcional)</span>
              </label>
              <textarea
                id="d-message"
                name="message"
                rows="4"
                class="mt-1.5 w-full rounded-lg border border-surface-border bg-white dark:bg-surface-secondary px-3 py-2.5 text-sm placeholder:text-ink-tertiary focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/20"
              ></textarea>
            </div>
            <button type="submit" class="btn-primary w-full">Solicitar demo</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
